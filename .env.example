# ============================================================
#  StudyBuddy · 环境变量示例
#  复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进仓库
#  cp .env.example .env
# ============================================================

# ---- 模型通道（三选一，默认走演示模式，不消耗任何额度）----

# ① WorkBuddy 账号通道（免密，走平台授权登录）
# 登录后调用计入使用者自己的 WorkBuddy 积分，作者零成本
VITE_WB_ENDPOINT=https://studybuddy-91919.app.workbuddy.host
VITE_WB_PUBLISHABLE_KEY=wbpk_xxxxxxxxxxxxxxxx
VITE_WB_OAUTH_RELAY_BASE_URL=https://www.workbuddy.cn/v2/as/genie-baas/oauth

# ② 自带 API Key（OpenAI 兼容协议：DeepSeek / Kimi / 智谱 / 通义 / Ollama…）
# VITE_OWN_BASE_URL=https://api.deepseek.com/v1
# VITE_OWN_API_KEY=sk-xxxxxxxx
# VITE_OWN_MODEL=deepseek-chat

# ---- 作者可选：公共体验通道（会消耗作者额度，默认不启用）----
# VITE_SHARED_BASE_URL=
# VITE_SHARED_KEY=
# VITE_SHARED_MODEL=
# VITE_SHARED_DAILY_LIMIT=30

# ---- 元信息 ----
VITE_APP_VERSION=1.0.0
VITE_AUTHOR_NOTE=
