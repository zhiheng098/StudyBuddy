# ============================================================
#  StudyBuddy · Git 忽略规则
#  原则：源码全进仓库，产物与本机状态一律不进
# ============================================================

# ---- 依赖（454MB，绝不能提交）----
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ---- 构建产物 ----
dist/
dist-ssr/
build/
.output/
*.tsbuildinfo

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- 日志 ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 缓存 ----
.cache/
.temp/
.tmp/
.vite/
.eslintcache
.stylelintcache
.oxlintcache

# ---- 测试与覆盖率 ----
coverage/
.nyc_output/

# ---- 编辑器 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- WorkBuddy 平台本地文件（不应进公共仓库）----
.workbuddy/
*.genie

# ---- 本地学习数据备份（StudyBuddy 导出的数据）----
studybuddy-backup-*.json

# ---- 系统 ----
Desktop.ini
$RECYCLE.BIN/
